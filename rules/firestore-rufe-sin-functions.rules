rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function secretaryGovernmentAdmin() {
      return signedIn()
        && (
          request.auth.uid == 'EWMigkOGDdeWYb04qLehDcalXyj2'
          || (
            hasEmail()
            && request.auth.token.email == 'secretariadegobierno@sanpedro-valle.gov.co'
          )
        );
    }

    function uidProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function legacyProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }

    function uidProfileExists() {
      return signedIn() && exists(uidProfilePath());
    }

    function legacyProfileExists() {
      return hasEmail() && exists(legacyProfilePath());
    }

    function roleOf(data) {
      return data.get(
        'role',
        data.get(
          'rol',
          data.get('tipoUsuario', data.get('userRole', 'guest'))
        )
      );
    }

    function active(data) {
      return data.get('active', true) == true;
    }

    function tokenRole() {
      return !signedIn()
        ? 'guest'
        : request.auth.token.get(
            'role',
            request.auth.token.get(
              'userRole',
              request.auth.token.get('super_admin', false) == true
                ? 'super_admin'
                : (
                    request.auth.token.get('admin', false) == true
                      ? 'admin'
                      : 'guest'
                  )
            )
          );
    }

    function guestRole(role) {
      return role in [
        'guest',
        'invitado',
        'visitante',
        'viewer',
        'usuario',
        'registered',
        'registrado'
      ];
    }

    function editorRole(role) {
      return role in [
        'editor',
        'validator',
        'validador',
        'admin',
        'administrador',
        'super_admin',
        'superadmin',
        'super_administrador',
        'superadministrador',
        'administrador_principal'
      ];
    }

    function adminRole(role) {
      return role in [
        'admin',
        'administrador',
        'super_admin',
        'superadmin',
        'super_administrador',
        'superadministrador',
        'administrador_principal'
      ];
    }

    function superRole(role) {
      return role in [
        'super_admin',
        'superadmin',
        'super_administrador',
        'superadministrador',
        'administrador_principal'
      ];
    }

    function tokenIsEditor() {
      return signedIn() && editorRole(tokenRole());
    }

    function tokenIsAdmin() {
      return signedIn() && adminRole(tokenRole());
    }

    function tokenIsSuperAdmin() {
      return signedIn() && superRole(tokenRole());
    }

    function uidIsEditor() {
      return uidProfileExists()
        && active(get(uidProfilePath()).data)
        && editorRole(roleOf(get(uidProfilePath()).data));
    }

    function uidIsAdmin() {
      return uidProfileExists()
        && active(get(uidProfilePath()).data)
        && adminRole(roleOf(get(uidProfilePath()).data));
    }

    function uidIsSuperAdmin() {
      return uidProfileExists()
        && active(get(uidProfilePath()).data)
        && superRole(roleOf(get(uidProfilePath()).data));
    }

    function legacyIsEditor() {
      return legacyProfileExists()
        && active(get(legacyProfilePath()).data)
        && editorRole(roleOf(get(legacyProfilePath()).data));
    }

    function legacyIsAdmin() {
      return legacyProfileExists()
        && active(get(legacyProfilePath()).data)
        && adminRole(roleOf(get(legacyProfilePath()).data));
    }

    function legacyIsSuperAdmin() {
      return legacyProfileExists()
        && active(get(legacyProfilePath()).data)
        && superRole(roleOf(get(legacyProfilePath()).data));
    }

    function isEditor() {
      return secretaryGovernmentAdmin()
        || tokenIsEditor()
        || uidIsEditor()
        || legacyIsEditor();
    }

    function isAdmin() {
      return secretaryGovernmentAdmin()
        || tokenIsAdmin()
        || uidIsAdmin()
        || legacyIsAdmin();
    }

    function isSuperAdmin() {
      return tokenIsSuperAdmin()
        || uidIsSuperAdmin()
        || legacyIsSuperAdmin();
    }

    function ownsProfile(userId) {
      return signedIn()
        && (
          userId == request.auth.uid
          || (
            hasEmail()
            && userId == request.auth.token.email
          )
        );
    }

    function validGuestCreate(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('role', '') == 'guest'
        && request.resource.data.get('active', false) == true;
    }

    function validOwnUpdate(userId) {
      return userId == request.auth.uid
        && request.resource.data.get('uid', '') == resource.data.get('uid', '')
        && roleOf(request.resource.data) == roleOf(resource.data)
        && request.resource.data.get('active', true) == resource.data.get('active', true)
        && request.resource.data.get('email', '') == resource.data.get('email', '')
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phone',
            'neighborhood',
            'emailVerified',
            'lastLoginAt',
            'updatedAt'
          ]);
    }

    // USUARIOS DEL PANEL RUFE SIN CLOUD FUNCTIONS
    match /users/{userId} {
      allow get: if ownsProfile(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || validGuestCreate(userId);

      allow update: if isAdmin()
        || validOwnUpdate(userId);

      allow delete: if isSuperAdmin();
    }


    // PUBLICACIONES DE FACEBOOK DEL PORTAL
    // Lectura pública; escritura exclusiva de administradores RUFE.
    match /rufeFacebookPosts/{postId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // PUBLICACIÓN RUFE
    match /rufePublished/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();

      match /releases/{releaseId} {
        allow get, list: if true;
        allow create, update, delete: if isSuperAdmin();
      }
    }

    // BORRADOR, FLUJO Y ADMINISTRACIÓN RUFE
    match /rufeEvents/{eventId} {
      allow get, list: if isEditor();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /drafts/{docId} {
        allow get, list: if isEditor();
        allow create, update: if isEditor();
        allow delete: if isSuperAdmin();
      }

      match /territories/{territoryId} {
        allow get, list: if isEditor();
        allow create, update: if isEditor();
        allow delete: if isSuperAdmin();
      }

      match /workflow/{docId} {
        allow get, list: if isEditor();
        allow create, update: if isEditor();
        allow delete: if false;
      }

      match /media/{mediaId} {
        allow get, list: if isEditor();
        allow create, update, delete: if isSuperAdmin();
      }

      match /releases/{releaseId} {
        allow get, list: if isEditor();
        allow create, update, delete: if isSuperAdmin();
      }

      match /editorActivity/{activityId} {
        allow get, list: if isEditor();
        allow create: if isEditor()
          && request.resource.data.get('uid', '') == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // AUDITORÍA RUFE SIN CLOUD FUNCTIONS
    match /rufeAudit/{logId} {
      allow create: if isEditor();
      allow get, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    // GARANTÍA FINAL: super_admin conserva acceso institucional.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
